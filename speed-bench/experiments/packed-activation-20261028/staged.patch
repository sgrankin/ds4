new file mode 100644
--- /dev/null
+++ b/tests/test_packed_activation.zig
@@ -0,0 +1,232 @@
+//! Compressed activation storage with the existing floating-point IQ2 GEMM.
+//! Small cases qualify tails, zero inputs and output boundaries; the bounded
+//! production shape records five alternating warm timing pairs after two warmups.
+const std = @import("std");
+const c = @import("packed_activation_gpu_c");
+const a = std.heap.c_allocator;
+extern "c" fn setenv([*:0]const u8, [*:0]const u8, c_int) c_int;
+extern "c" fn posix_memalign(*?*anyopaque, usize, usize) c_int;
+extern "c" fn free(?*anyopaque) void;
+
+const Shape = struct { input: usize, middle: usize, output: usize, experts: usize };
+const Timespec = extern struct { seconds: isize, nanoseconds: isize };
+extern "c" fn clock_gettime(c_int, *Timespec) c_int;
+
+fn nanoseconds() !u64 {
+    var t: Timespec = undefined;
+    // Darwin CLOCK_MONOTONIC; this fixture links the macOS Metal runtime.
+    try require(clock_gettime(6, &t) == 0, "read monotonic clock");
+    return @as(u64, @intCast(t.seconds)) * 1_000_000_000 + @as(u64, @intCast(t.nanoseconds));
+}
+const S = 6;
+const Iq = extern struct { d: u16, qs: [32]u16 };
+const Q2 = extern struct { scales: [16]u8, qs: [64]u8, d: u16, dmin: u16 };
+const Tensor = *c.ds4_gpu_tensor;
+var seed: u32 = 137;
+
+fn random() u32 {
+    seed ^= seed << 13;
+    seed ^= seed >> 17;
+    seed ^= seed << 5;
+    return seed;
+}
+fn require(ok: bool, message: []const u8) !void {
+    if (!ok) {
+        std.debug.print("packed activation: {s}\n", .{message});
+        return error.CheckFailed;
+    }
+}
+fn allocTensor(bytes: usize) !Tensor {
+    return c.ds4_gpu_tensor_alloc(bytes) orelse error.OutOfMemory;
+}
+fn runCase(shape: Shape, model: []const u8, gate_bytes: usize, down_bytes: usize, rows: u32, zero: bool, benchmark: bool) !void {
+    const D = shape.input;
+    const H = shape.middle;
+    const O = shape.output;
+    const E = shape.experts;
+    const pairs: usize = @as(usize, rows) * S;
+    const x = try a.alloc(f32, @as(usize, rows) * D);
+    defer a.free(x);
+    const ids = try a.alloc(i32, pairs);
+    defer a.free(ids);
+    const weights = try a.alloc(f32, pairs);
+    defer a.free(weights);
+    for (x) |*value| {
+        const n: i32 = @intCast(random() % 101);
+        value.* = if (zero) 0 else @as(f32, @floatFromInt(n - 50)) / 256;
+    }
+    for (0..rows) |t| {
+        ids[t * S] = 0; // A hot expert plus uneven groups and unused experts.
+        for (1..S) |s| ids[t * S + s] = if (benchmark) @intCast(s) else @intCast(1 + (t * 7 + s * 19) % (E - 17));
+    }
+    @memset(weights, 1.0 / @as(f32, S));
+    const xt = try allocTensor(x.len * 4);
+    defer c.ds4_gpu_tensor_free(xt);
+    const it = try allocTensor(ids.len * 4);
+    defer c.ds4_gpu_tensor_free(it);
+    const wt = try allocTensor(weights.len * 4);
+    defer c.ds4_gpu_tensor_free(wt);
+    try require(c.ds4_gpu_tensor_write(xt, 0, x.ptr, x.len * 4) != 0, "write activations");
+    try require(c.ds4_gpu_tensor_write(it, 0, ids.ptr, ids.len * 4) != 0, "write routes");
+    try require(c.ds4_gpu_tensor_write(wt, 0, weights.ptr, weights.len * 4) != 0, "write route weights");
+    const counts = [_]usize{ pairs * H, pairs * H, pairs * H, pairs * O, @as(usize, rows) * O };
+    var tensors: [5]?Tensor = @splat(null);
+    defer for (tensors) |tensor| if (tensor) |t| c.ds4_gpu_tensor_free(t);
+    for (&tensors, counts) |*tensor, count| tensor.* = try allocTensor((count + 1) * 4);
+    const reference = try a.alloc(f32, counts[4]);
+    defer a.free(reference);
+    var max_count: usize = 0;
+    for (counts) |count| max_count = @max(max_count, count);
+    const actual = try a.alloc(f32, max_count + 1);
+    defer a.free(actual);
+    // First control/candidate calls warm both pipelines. Every subsequent call
+    // is retained: AB, BA, AB, BA, AB. Inputs and model stay fixed across arms.
+    const calls: usize = if (benchmark) 12 else 2;
+    for (0..calls) |call| {
+        const measured = benchmark and call >= 2;
+        const sample = if (measured) (call - 2) / 2 else 0;
+        const arm = if (measured) ((call - 2) % 2) ^ (sample % 2) else call;
+        try require(setenv("DS4_METAL_ROUTED_PACKED_ACT_I8", if (arm == 0) "0" else "1", 1) == 0, "set storage arm");
+        // Refresh activation storage before timing, so both arms consume the
+        // same newly uploaded input. Allocation, uploads and checks are untimed.
+        try require(c.ds4_gpu_tensor_write(xt, 0, x.ptr, x.len * 4) != 0, "refresh activations");
+        for (tensors, counts) |tensor, count|
+            try require(c.ds4_gpu_tensor_fill_f32(tensor.?, std.math.nan(f32), count + 1) != 0, "fill output sentinel");
+        try require(c.ds4_gpu_synchronize() != 0, "finish setup before timing");
+        var half_mid = false;
+        const start = try nanoseconds();
+        try require(c.ds4_gpu_routed_moe_batch_tensor(
+            tensors[4],
+            tensors[0],
+            tensors[1],
+            tensors[2],
+            tensors[3],
+            model.ptr,
+            model.len,
+            0,
+            gate_bytes * E,
+            gate_bytes * E * 2,
+            16,
+            10,
+            gate_bytes,
+            D / 256 * @sizeOf(Iq),
+            down_bytes,
+            H / 256 * @sizeOf(Q2),
+            @intCast(D),
+            @intCast(H),
+            @intCast(O),
+            it,
+            wt,
+            @intCast(E),
+            S,
+            7,
+            xt,
+            0,
+            rows,
+            &half_mid,
+            true,
+        ) != 0, "routed prefill succeeds");
+        try require(c.ds4_gpu_synchronize() != 0, "finish GPU call before timing ends");
+        const elapsed_ms = @as(f64, @floatFromInt((try nanoseconds()) - start)) / 1_000_000;
+        if (benchmark) std.debug.print("packed_activation_leaf,{s},{d},{s},{d},{d},{d},{d},{d:.6}\n", .{
+            if (measured) "sample" else "warmup",      sample + 1,
+            if (arm == 0) "control" else "compressed", rows,
+            D,                                         H,
+            E,                                         elapsed_ms,
+        });
+        try require(half_mid, "prefill uses the established F16 middle buffer");
+        for (tensors, counts, 0..) |tensor, count, index| {
+            // Gate/up and final values are all materialized by this packed path.
+            // The middle is F16 in the first half of its allocated F32 space.
+            const used_bytes = count * (if (index == 2) @as(usize, 2) else 4);
+            try require(c.ds4_gpu_tensor_read(tensor.?, 0, actual.ptr, used_bytes) != 0, "read consumed output");
+            for (0..count) |i| {
+                const value: f32 = if (index == 2) @as([*]const f16, @ptrCast(actual.ptr))[i] else actual[i];
+                try require(std.math.isFinite(value), "all consumed outputs finite");
+                if (zero) try require(value == 0, "zero activations remain zero");
+            }
+            var sentinel: f32 = 0;
+            try require(c.ds4_gpu_tensor_read(tensor.?, count * 4, &sentinel, 4) != 0, "read output boundary sentinel");
+            try require(std.math.isNan(sentinel), "output boundary preserved");
+        }
+        try require(c.ds4_gpu_tensor_read(tensors[4].?, 0, actual.ptr, counts[4] * 4) != 0, "read final mixture");
+        if (arm == 0) {
+            @memcpy(reference, actual[0..reference.len]);
+        } else {
+            var maximum: f64 = 0;
+            var error_square: f64 = 0;
+            var old_square: f64 = 0;
+            var new_square: f64 = 0;
+            var cross: f64 = 0;
+            for (reference, actual[0..reference.len]) |old, new| {
+                const delta = @as(f64, new) - old;
+                maximum = @max(maximum, @abs(delta));
+                error_square += delta * delta;
+                old_square += @as(f64, old) * old;
+                new_square += @as(f64, new) * new;
+                cross += @as(f64, old) * new;
+            }
+            const n: f64 = @floatFromInt(reference.len);
+            const cosine = if (old_square == 0 and new_square == 0) @as(f64, 1) else cross / @sqrt(old_square * new_square);
+            const relative_rms = if (old_square == 0) @as(f64, 0) else @sqrt(error_square / old_square);
+            std.debug.print("packed activation rows={d} input={d} zero={} max_abs={d} rms={d} relative_rms={d} cosine={d}\n", .{ rows, D, zero, maximum, @sqrt(error_square / n), relative_rms, cosine });
+            // A very loose structural bound catches indexing/scaling failures;
+            // quality is judged by the real-model teacher/task measurements.
+            try require(zero or (std.math.isFinite(cosine) and cosine > 0.9), "mixture direction is coherent");
+        }
+    }
+}
+
+fn runShape(shape: Shape, benchmark: bool) !void {
+    const D = shape.input;
+    const H = shape.middle;
+    const O = shape.output;
+    const E = shape.experts;
+    const gate_bytes = H * (D / 256) * @sizeOf(Iq);
+    const down_bytes = O * (H / 256) * @sizeOf(Q2);
+    const model_bytes = (2 * gate_bytes * E + down_bytes * E + 16383) / 16384 * 16384;
+    var owner: ?*anyopaque = null;
+    try require(posix_memalign(&owner, 16384, model_bytes) == 0, "allocate aligned fake model");
+    defer free(owner);
+    const model = @as([*]u8, @ptrCast(owner.?))[0..model_bytes];
+    @memset(model, 0);
+    const iq = @as([*]Iq, @ptrCast(@alignCast(model.ptr)))[0 .. 2 * gate_bytes * E / @sizeOf(Iq)];
+    for (iq) |*block| {
+        block.d = @bitCast(@as(f16, 0.001));
+        for (&block.qs) |*q| q.* = @truncate(random());
+    }
+    const q2 = @as([*]Q2, @ptrCast(@alignCast(model.ptr + 2 * gate_bytes * E)))[0 .. down_bytes * E / @sizeOf(Q2)];
+    for (q2) |*block| {
+        block.d = @bitCast(@as(f16, 0.001));
+        block.dmin = @bitCast(@as(f16, 0.0005));
+        for (&block.scales) |*value| value.* = @truncate(random());
+        for (&block.qs) |*value| value.* = @truncate(random());
+    }
+    try require(c.ds4_gpu_init() != 0, "initialize Metal");
+    defer c.ds4_gpu_cleanup(); // No-copy model views retire before owner memory.
+    try require(c.ds4_gpu_set_model_map(model.ptr, model.len) != 0, "map fake quantized weights");
+    c.ds4_gpu_set_quality(false);
+    c.ds4_gpu_set_ssd_streaming(false);
+    std.debug.print("packed activation model_bytes={d} input={d} middle={d} output={d} experts={d}\n", .{ model_bytes, D, H, O, E });
+    if (benchmark) {
+        try runCase(shape, model, gate_bytes, down_bytes, 512, false, true);
+    } else {
+        try runCase(shape, model, gate_bytes, down_bytes, 512, false, false);
+        try runCase(shape, model, gate_bytes, down_bytes, 513, false, false);
+        try runCase(shape, model, gate_bytes, down_bytes, 1024, false, false);
+        try runCase(shape, model, gate_bytes, down_bytes, 512, true, false);
+    }
+}
+
+pub fn main() !void {
+    comptime {
+        if (@sizeOf(Iq) != 66 or @sizeOf(Q2) != 84) @compileError("quantized block layout mismatch");
+    }
+    try require(setenv("DS4_METAL_DISABLE_V41_PACKED_M32N128", "1", 1) == 0, "hold M64 tile fixed");
+    try runShape(.{ .input = 256, .middle = 512, .output = 260, .experts = 256 }, false);
+    std.debug.print("packed_activation_leaf,phase,pair,arm,rows,input,middle,experts,milliseconds\n", .{});
+    // Six fixed routed experts; roughly 60 MiB of weights. This exercises the
+    // production widths without a second full model or hundreds of experts.
+    try runShape(.{ .input = 5120, .middle = 2304, .output = 5120, .experts = 6 }, true);
+    std.debug.print("packed activation finite/tails/zero/sentinel qualification: PASS\n", .{});
+}
