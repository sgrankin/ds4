+// Read a compact activation pack but keep the established floating-point
+// matrix multiplication: IQ2 weights become the same half tiles, activations
+// become small half tiles, and the F32 accumulator spans the complete K loop.
+// Neither weights nor the full RHS are expanded into persistent half owners.
+kernel void kernel_mul_mm_id_iq2_xxs_mpp_act_i8(
+        constant ds4_metal_args_mul_mm_id &args,
+        device const char *src0,
+        device const half *src1,
+        device const uint *counts,
+        device const int *ids,
+        device float *dst,
+        device const uint *work,
+        threadgroup char *shmem [[threadgroup(0)]],
+        uint2 group [[threadgroup_position_in_grid]],
+        ushort tid [[thread_index_in_threadgroup]]) {
+    constexpr int M = 64, N = 32, K = 32;
+    if (group.x >= work[0]) return;
+    const uint2 item = ((device const uint2 *)(work + 2))[group.x];
+    if (item.y % N) return;
+    const int expert = item.x, r0 = group.y*M, r1 = item.y;
+    const int nr0 = min(M, args.ne0 - r0);
+    const int nr1 = min(N, (int)counts[expert] - r1);
+    if (nr0 <= 0 || nr1 <= 0) return;
+    if (!ds4_tp_owns_expert(expert, args.ne02, args.tp_rank, args.tp_world)) {
+        for (int i = tid; i < nr1*nr0; i += 128) {
+            const int id = ids[expert*args.ne21 + r1 + i/nr0];
+            dst[(uint64_t)(id/args.ne20)*args.ne1*args.ne0 +
+                (id%args.ne20)*args.ne0 + r0 + i%nr0] = 0;
+        }
+        return;
+    }
+
+    // Two half weight tiles followed by two half activation tiles: 12 KiB.
+    threadgroup half *weights = (threadgroup half *)shmem;
+    threadgroup half *activations = weights + 2*M*K;
+    auto w0 = tensor(weights, dextents<int32_t, 2>(K, M));
+    auto w1 = tensor(weights + M*K, dextents<int32_t, 2>(K, M));
+    auto x0 = tensor(activations, dextents<int32_t, 2>(K, N));
+    auto x1 = tensor(activations + N*K, dextents<int32_t, 2>(K, N));
+    device const uint *offsets = (device const uint *)src1;
+    device const int8_t *codes = (device const int8_t *)(offsets + ((args.ne02 + 31u) & ~31u));
+    const uint64_t elements = (uint64_t)args.ne20*args.ne21*args.ne00;
+    const uint groups = args.ne00/32;
+    const uint packed_row = offsets[expert] + r1;
+    device const float *scales = (device const float *)(codes + elements) +
+        (uint64_t)packed_row*groups;
+    codes += (uint64_t)packed_row*args.ne00;
+
+    matmul2d<matmul2d_descriptor(N, M, K, false, true, false,
+                                matmul2d_descriptor::mode::multiply_accumulate),
+             execution_simdgroups<4>> mm;
+    auto acc = mm.template get_destination_cooperative_tensor<decltype(x0), decltype(w0), float>();
+    for (uint16_t i = 0; i < acc.get_capacity(); ++i)
+        if (acc.is_valid_element(i)) acc[i] = 0;
+
+    auto stage = [&](int k, uint buffer) {
+        threadgroup half *wt = weights + buffer*M*K;
+        // Preserve the old IQ2 decoder and its half-rounding boundary.
+        if (tid < M*2) {
+            const int row = min((int)tid/2, nr0 - 1);
+            const int col = k + 16*(tid%2);
+            device const block_iq2_xxs *w = (device const block_iq2_xxs *)(src0 +
+                (uint64_t)(expert - args.tp_expert_base)*args.nb02 +
+                (r0 + row)*args.nb01);
+            half4x4 values;
+            dequantize_iq2_xxs(w + col/(16*QK_NL), (col/16)%QK_NL, values);
+            *((threadgroup half4x4 *)(wt + (tid/2)*K + 16*(tid%2))) = values;
+        }
+        threadgroup half *xt = activations + buffer*N*K;
+        for (uint vector = tid; vector < N*K/4; vector += 128) {
+            const uint row = vector/(K/4), col = 4*(vector%(K/4));
+            half4 value = half4(0);
+            if (row < (uint)nr1) {
+                const char4 q = *((device const char4 *)(codes + (uint64_t)row*args.ne00 + k + col));
+                const float scale = scales[(uint64_t)row*groups + k/32];
+                value = half4(float4(q)*scale);
+            }
+            *((threadgroup half4 *)(xt + row*K + col)) = value;
+        }
+    };
+    stage(0, 0);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    uint buffer = 0;
+    for (int k = 0; k < args.ne00; k += K) {
+        auto x = (buffer ? x1 : x0).slice(0, 0);
+        auto w = (buffer ? w1 : w0).slice(0, 0);
+        mm.run(x, w, acc);
+        if (k + K < args.ne00) {
+            buffer ^= 1;
+            stage(k + K, buffer);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    // The 8 KiB output tile reuses weight staging after its last read retires.
+    auto out = tensor((threadgroup float *)shmem, dextents<int32_t, 2>(M, N));
+    acc.store(out);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (int i = tid; i < nr1*nr0; i += 128) {
+        const int id = ids[expert*args.ne21 + r1 + i/nr0];
+        dst[(uint64_t)(id/args.ne20)*args.ne1*args.ne0 +
+            (id%args.ne20)*args.ne0 + r0 + i%nr0] =
+            ((threadgroup float *)shmem)[(i/nr0)*M + i%nr0];
+    }
+}
+
 // Routed-expert grouped matmul on the Metal4 TensorOps/MPP pipeline. The
 // barrier after mm.run prevents the next K iteration from replacing staged
 // tiles while the cooperative matmul still reads them.
