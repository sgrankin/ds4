def solve(payload, config):
    merge_touching = config["merge_touching"] if "merge_touching" in config else True
    intervals = []
    for item in payload:
        if len(item) == 2:
            start = item[0]
            end = item[1]
            if start < end:
                intervals.append([start, end])
    intervals.sort()
    result = []
    for interval in intervals:
        if not result:
            result.append([interval[0], interval[1]])
        else:
            last = result[-1]
            if merge_touching:
                if interval[0] <= last[1]:
                    if interval[1] > last[1]:
                        last[1] = interval[1]
                else:
                    result.append([interval[0], interval[1]])
            else:
                if interval[0] < last[1]:
                    if interval[1] > last[1]:
                        last[1] = interval[1]
                else:
                    result.append([interval[0], interval[1]])
    return result

