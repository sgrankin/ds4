Algorithm details:
def solve(payload, config):
    merge_touching = config.get("merge_touching", False)
    valid = []
    for interval in payload:
        start = interval[0]
        end = interval[1]
        if start < end:
            valid.append([start, end])
    valid = sorted(valid)
    result = []
    for interval in valid:
        if not result:
            result.append(interval)
        else:
            last = result[-1]
            if merge_touching:
                if interval[0] <= last[1]:
                    if interval[1] > last[1]:
                        last[1] = interval[1]
                    # else keep
                else:
                    result.append(interval)
            else:
                if interval[0] < last[1]:
                    if interval[1] > last[1]:
                        last[1] = interval[1]
                else:
                    result.append(interval)
    return result

