from pathlib import Path
import re
p = Path("context.txt"); s = p.read_text()
parts = re.split(r"(\n\[\[DS4_TURN (\d+) role=\w+\]\]\n)", s)
drop = {1}
out = [parts[0]]
for i in range(1, len(parts), 3):
    tid = int(parts[i+1])
    if tid in drop:
        Path("archived-turn.txt").write_text(parts[i] + parts[i+2])
    else:
        out += [parts[i], parts[i+2]]
p.write_text(''.join(out))
print("archived and dropped turn", sorted(drop))
