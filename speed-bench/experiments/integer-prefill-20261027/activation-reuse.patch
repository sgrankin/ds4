+// Quantize each packed activation once, rather than once per output tile and
+// again for up. Keep the previous F32 -> half boundary before INT8 rounding.
+// Layout: aligned expert offsets, all INT8 rows, then one F32 scale per 32 codes.
+kernel void kernel_moe_pack_rhs_i8(
+        constant ds4_metal_args_mul_mm_id &args,
+        device const char *src,
+        device const uint *counts,
+        device const int *ids,
+        device const uint *work,
+        device char *dst,
+        uint row [[threadgroup_position_in_grid]],
+        uint tid [[thread_index_in_threadgroup]]) {
+    const uint wi = row/32;
+    if (wi >= work[0]) return;
+    const uint2 item = ((device const uint2 *)(work + 2))[wi];
+    if (!ds4_tp_owns_expert(item.x, args.ne02, args.tp_rank, args.tp_world)) return;
+    const uint ri = item.y + row%32;
+    if (ri >= counts[item.x]) return;
+    device const uint *offsets = (device const uint *)dst;
+    const uint packed_row = offsets[item.x] + ri;
+    const uint width = args.ne00, groups = width/32;
+    const uint64_t elements = (uint64_t)args.ne20*args.ne21*width;
+    device int8_t *codes = (device int8_t *)((device uint *)dst + ((args.ne02 + 31u) & ~31u));
+    device float *scales = (device float *)(codes + elements);
+    const int id = ids[item.x*args.ne21 + ri];
+    device const float *x = (device const float *)(src +
+        args.nb12*(id/args.ne20) + args.nb11*((id%args.ne20)%args.ne11));
+    const uint lane = tid%32, simdgroup = tid/32;
+    for (uint block = simdgroup; block < groups; block += 4) {
+        const float value = (float)(half)x[block*32 + lane];
+        const float maximum = simd_max(abs(value));
+        const float scale = maximum > 0 ? maximum/127.0f : 1.0f;
+        if (lane == 0) scales[(uint64_t)packed_row*groups + block] = scale;
+        codes[(uint64_t)packed_row*width + block*32 + lane] =
+            (int8_t)clamp(rint(value/scale), -127.0f, 127.0f);
+    }
+}
