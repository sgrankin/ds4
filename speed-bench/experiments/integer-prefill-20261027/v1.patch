+// Experimental IQ2 prefill: retain the original 66-byte weight blocks, decode
+// their exact signed grid values into a small INT8 tile, and quantize only the
+// current activation tile. Each 32-column group has its own original weight
+// scale and dynamic activation scale. Integer products accumulate in INT32;
+// group results are rescaled into private F32 accumulators. This is not a
+// persistent INT8 weight cache. The W8A8 arithmetic follows the same approach
+// as Draw Things' NAInt8MatMulKernel; IQ2's per-group scales stay explicit here.
+kernel void kernel_mul_mm_id_iq2_xxs_mpp_i8(
+        constant ds4_metal_args_mul_mm_id &args,
+        device const char *src0,
+        device const half *src1,
+        device const uint *counts,
+        device const int *ids,
+        device float *dst,
+        device const uint *work,
+        threadgroup char *shmem [[threadgroup(0)]],
+        uint2 group [[threadgroup_position_in_grid]],
+        ushort tid [[thread_index_in_threadgroup]]) {
+    constexpr int M = 64, N = 32, K = 32;
+    if (group.x >= work[0]) return;
+    const uint2 item = ((device const uint2 *)(work + 2))[group.x];
+    const int expert = item.x, r0 = group.y*M, r1 = item.y;
+    const int nr0 = min(M, args.ne0 - r0);
+    const int nr1 = min(N, (int)counts[expert] - r1);
+    if (nr0 <= 0 || nr1 <= 0) return;
+    if (!ds4_tp_owns_expert(expert, args.ne02, args.tp_rank, args.tp_world)) {
+        for (int i = tid; i < nr1*nr0; i += 128) {
+            const int id = ids[expert*args.ne21 + r1 + i/nr0];
+            dst[(uint64_t)(id/args.ne20)*args.ne1*args.ne0 +
+                (id%args.ne20)*args.ne0 + r0 + i%nr0] = 0;
+        }
+        return;
+    }
+
+    threadgroup int8_t *weights = (threadgroup int8_t *)shmem;
+    threadgroup int8_t *activations = weights + M*K;
+    threadgroup float *weight_scales = (threadgroup float *)(activations + N*K);
+    threadgroup float *activation_scales = weight_scales + M;
+    device const uint *offsets = (device const uint *)src1;
+    device const half *rhs = (device const half *)(offsets + ((args.ne02 + 31u) & ~31u));
+    rhs += (uint64_t)(offsets[expert] + r1)*args.ne00;
+
+    auto a = tensor(activations, dextents<int32_t, 2>(K, N));
+    auto b = tensor(weights, dextents<int32_t, 2>(K, M));
+    matmul2d<matmul2d_descriptor(N, M, K, false, true, false,
+                                matmul2d_descriptor::mode::multiply_accumulate),
+             execution_simdgroups<4>> mm;
+    auto partial = mm.template get_destination_cooperative_tensor<decltype(a), decltype(b), int32_t>();
+    // At most one SIMDgroup can own the complete tile. The compiler eliminates
+    // unused slots when specializing the cooperative tensor distribution.
+    float total[M*N/32];
+    #pragma clang loop unroll(full)
+    for (uint16_t i = 0; i < partial.get_capacity(); ++i)
+        if (partial.is_valid_element(i)) total[i] = 0;
+
+    for (int k = 0; k < args.ne00; k += K) {
+        if (tid < M) {
+            const int row = tid;
+            if (row < nr0) {
+                device const block_iq2_xxs *w = (device const block_iq2_xxs *)(src0 +
+                    (uint64_t)(expert - args.tp_expert_base)*args.nb02 +
+                    (r0 + row)*args.nb01);
+                device const block_iq2_xxs *block = w + k/QK_K;
+                device const ushort *q = block->qs + 4*((k%QK_K)/32);
+                const uint grids = (uint)q[0] | ((uint)q[1] << 16);
+                const uint signs_and_scale = (uint)q[2] | ((uint)q[3] << 16);
+                weight_scales[row] = (float)block->d *
+                    (0.5f + (float)(signs_and_scale >> 28)) * 0.25f;
+                #pragma clang loop unroll(full)
+                for (int g = 0; g < 4; ++g) {
+                    const uint grid_id = (grids >> (8*g)) & 255u;
+                    constant const uchar *grid = (constant const uchar *)(iq2xxs_grid + grid_id);
+                    const uchar signs = ksigns_iq2xs[(signs_and_scale >> (7*g)) & 127u];
+                    #pragma clang loop unroll(full)
+                    for (int j = 0; j < 8; ++j)
+                        weights[row*K + 8*g + j] = (int8_t)((signs & kmask_iq2xs[j]) ?
+                            -(int)grid[j] : (int)grid[j]);
+                }
+            } else {
+                weight_scales[row] = 0;
+                #pragma clang loop unroll(full)
+                for (int j = 0; j < K; ++j) weights[row*K + j] = 0;
+            }
+        }
+        // One SIMDgroup quantizes a row, with one input value per lane.
+        // All groups cover N rows without private 32-value staging arrays.
+        const int lane = tid % 32, simdgroup = tid / 32;
+        for (int row = simdgroup; row < N; row += 4) {
+            const float value = row < nr1 ? (float)rhs[(uint64_t)row*args.ne00 + k + lane] : 0;
+            const float maximum = simd_max(abs(value));
+            const float scale = maximum > 0 ? maximum / 127.0f : 1.0f;
+            if (lane == 0) activation_scales[row] = scale;
+            activations[row*K + lane] = (int8_t)clamp(rint(value / scale), -127.0f, 127.0f);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        #pragma clang loop unroll(full)
+        for (uint16_t i = 0; i < partial.get_capacity(); ++i)
+            if (partial.is_valid_element(i)) partial[i] = 0;
+        mm.run(a, b, partial);
+        #pragma clang loop unroll(full)
+        for (uint16_t i = 0; i < partial.get_capacity(); ++i) {
+            if (partial.is_valid_element(i)) {
+                const auto position = partial.get_multidimensional_index(i);
+                total[i] += (float)partial[i] * weight_scales[position[0]] * activation_scales[position[1]];
+            }
+        }
+        // Matmul and rescaling must finish before the next K group replaces
+        // either integer tile or its scales.
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    #pragma clang loop unroll(full)
+    for (uint16_t i = 0; i < partial.get_capacity(); ++i) {
+        if (partial.is_valid_element(i)) {
+            const auto position = partial.get_multidimensional_index(i);
+            const int output_row = position[0], input_row = position[1];
+            if (output_row < nr0 && input_row < nr1) {
+                const int id = ids[expert*args.ne21 + r1 + input_row];
+                dst[(uint64_t)(id/args.ne20)*args.ne1*args.ne0 +
+                    (id%args.ne20)*args.ne0 + r0 + output_row] = total[i];
+            }
+        }
+    }
+}
