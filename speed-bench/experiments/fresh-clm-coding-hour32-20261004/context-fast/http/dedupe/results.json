        "arguments": "{\"path\":\"/Volumes/Models/ds4/.workspaces/server-agent-day-20261004/fresh32-visible/dedupe/solution.py\",\"content\":\"def solve(payload, config):\\n    ttl = config[\\\"ttl\\\"]\\n    accepted = []\\n    rejected = []\\n    last = {}\\n    index = 0\\n    for event in payload:\\n        key = event[\\\"key\\\"]\\n        t = event[\\\"t\\\"]\\n        if key not in last:\\n            accepted.append(index)\\n            last[key] = t\\n        else:\\n            if t - last[key] >= ttl:\\n                accepted.append(index)\\n                last[key] = t\\n            else:\\n                rejected.append(index)\\n        index = index + 1\\n    return {\\\"accepted\\\": accepted, \\\"rejected\\\": rejected}\\n\"}",
