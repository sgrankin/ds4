     pthread_mutex_lock(&s->inference_mu);
 }
 
-/* Scope approximate sources by a client hint, but still match token history.
- * Exact native prefixes retain the shared model/forward-profile namespace. */
+/* Scope suffix sources by client hint and private decoder replay by its
+ * settings. Both still require matching token history at the live frontier. */
 static void server_context_cache_profile(const server *s, const request *req,
                                           char profile[41]) {
     memset(profile, 0, 41);
-    if (!s || !s->context_suffix_reuse || !req || req->kind != REQ_CHAT ||
-        req->image_count || !req->prompt_cache_key || !req->prompt_cache_key[0])
-        return;
+    if (!s || !req || req->kind != REQ_CHAT || req->image_count) return;
+    const char *replay_rows = NULL;
+    if (s->context_suffix_reuse) {
+        if (!req->prompt_cache_key || !req->prompt_cache_key[0]) return;
+    } else {
+        replay_rows = getenv("DS4_V41_DECODER_REPLAY_ROWS");
+        if (!replay_rows || (strcmp(replay_rows, "128") && strcmp(replay_rows, "256"))) return;
+    }
     buf identity = {0};
     buf_puts(&identity, s->state_cache_profile);
-    if (s->context_suffix_right) buf_puts(&identity, ":right-v1");
-    buf_puts(&identity, ":suffix:");
-    buf_puts(&identity, req->prompt_cache_key);
+    if (s->context_suffix_reuse) {
+        if (s->context_suffix_right) buf_puts(&identity, ":right-v1");
+        buf_puts(&identity, ":suffix:");
+        buf_puts(&identity, req->prompt_cache_key);
+    } else {
+        /* Replay keeps only a private live graph; suffix capture/export stays
+         * disabled. Retain it across matching continuations of this profile. */
+        const char *selected = getenv("DS4_V41_DECODER_REPLAY_SELECTED");
+        buf_puts(&identity, ":decoder-replay-v1:");
+        buf_puts(&identity, replay_rows);
+        buf_puts(&identity, selected && !strcmp(selected, "1") ? ":selected1" : ":selected0");
+        if (req->prompt_cache_key && req->prompt_cache_key[0]) {
+            buf_puts(&identity, ":hint:");
+            buf_puts(&identity, req->prompt_cache_key);
+        }
+    }
     ds4_kvstore_sha1_bytes_hex(identity.ptr, identity.len, profile);
     buf_free(&identity);
 }
