      "arguments": "{\"path\":\"/Volumes/Models/ds4/.workspaces/server-agent-day-20261004/fresh32-visible/dedupe/solution.py\",\"content\":\"def solve(payload, config):\\n    ttl = config[\\\"ttl\\\"]\\n    accepted = []\\n    rejected = []\\n    last = {}\\n    i = 0\\n    while i < len(payload):\\n        event = payload[i]\\n        t = event[\\\"t\\\"]\\n        key = event[\\\"key\\\"]\\n        if key not in last:\\n            accepted.append(i)\\n            last[key] = t\\n        else:\\n            if t - last[key] >= ttl:\\n                accepted.append(i)\\n                last[key] = t\\n            else:\\n                rejected.append(i)\\n        i = i + 1\\n    return {\\\"accepted\\\": accepted, \\\"rejected\\\": rejected}\\n\"}",
