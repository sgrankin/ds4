def cents(text):
    """Convert a dollar amount to integer cents."""
    text = str(text).strip()
    if '.' in text:
        whole, frac = text.split('.', 1)
    else:
        whole, frac = text, ''
    frac = (frac + '00')[:2]
    return int(whole) * 100 + int(frac)
```

