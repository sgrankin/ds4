+static void write_raw_row(FILE *output, const uint32_t key[4], uint64_t hash,
+                          const float *raw, int vocab) {
+    if (fwrite(key, sizeof(uint32_t), 4, output) != 4 ||
+        fwrite(&hash, sizeof(hash), 1, output) != 1 ||
+        fwrite(raw, sizeof(float), (size_t)vocab, output) != (size_t)vocab)
+        fail("private raw export write failed");
+}
+
+static uint64_t checked_delta(uint64_t after, uint64_t before) {
+    if (after < before) fail("private phase I/O counter decreased");
+    return after - before;
+}
+
+static void write_phase_io(FILE *output, int phase, char kind,
+        const ds4_gpu_stream_expert_io_metrics *before,
+        const ds4_gpu_stream_expert_io_metrics *after) {
+    if (!before->explicit_io_metrics_enabled || !after->explicit_io_metrics_enabled)
+        fail("private exact demand I/O metrics disabled");
+    uint32_t slots = ds4_gpu_stream_expert_cache_configured_count();
+    if (slots != 6136) fail("private configured expert slots differ from6136");
+    fprintf(output,"{\"phase\":%d,\"kind\":\"%c\",\"configured_slots\":%u,\"resident_entries\":%u",
+            phase,kind,slots,ds4_gpu_stream_expert_cache_current_count());
+#define IO_DELTA(field) fprintf(output,",\"" #field "\":%" PRIu64,checked_delta(after->field,before->field))
+    IO_DELTA(pread_calls); IO_DELTA(pread_requested_bytes); IO_DELTA(pread_returned_bytes);
+    IO_DELTA(cache_loader_returned_bytes); IO_DELTA(cache_hits); IO_DELTA(cache_misses); IO_DELTA(cache_evictions);
+#undef IO_DELTA
+    fprintf(output,"}\n");
+    if (fflush(output)) fail("private phase I/O flush failed");
+}
