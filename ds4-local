#!/usr/bin/env nu
# Opt-in local profiles. Later arguments override the program's CLI defaults.
const ROOT = path self .
const USAGE = 'Usage: ds4-local [--server] [--bin-dir DIR] [--preset] context-fast|resident-fast|persistent-fast|flint|clef-flash|clef|clef-omni [binary arguments]'

def env-or [name: string, fallback: string] {
    $env | get --optional $name | default --empty $fallback
}

def usage-error [] {
    print --stderr $USAGE
    exit 2
}

def shader-settings [] {
    mut settings = {}
    # Absolute sources keep --chdir usable; explicit shader overrides win.
    for source in (glob ($ROOT | path join 'src/metal/*.metal')) {
        let name = (
            $source
            | path parse
            | get stem
            | str uppercase
        )
        let key = $'DS4_METAL_($name)_SOURCE'
        $settings = ($settings | upsert $key (env-or $key $source))
    }
    $settings
}

# Keep program arguments as strings, including --help after a preset.
def --wrapped main [...arguments: string] {
    mut args = $arguments
    mut server = false
    mut bin_dir = $ROOT
    while not ($args | is-empty) {
        match $args.0 {
            '--server' => {
                $server = true
                $args = ($args | skip 1)
            }
            '--bin-dir' => {
                if (($args | length) < 2) or ($args.1 == '') { usage-error }
                $bin_dir = $args.1
                $args = ($args | skip 2)
            }
            '--preset' => { $args = ($args | skip 1) }
            _ => { break }
        }
    }
    let preset = $args | get --optional 0 | default ''
    if $preset in ['--help' '-h'] {
        print $USAGE
        print 'persistent-fast combines left/right suffix reuse with decode and prefill resident substitutions for ds4-agent or ds4-server.'
        print 'flint is server-only: native resident decoding with durable Responses JSON; provide --model DIR.'
        print 'clef-flash, clef and clef-omni are server-only decision profiles; downloaded model directories are selected by default.'
        print 'Profiles enable matching text-prefix reuse for loaded Clef/Flash helpers; DS4_CLEF_PREFIX_CACHE=0 disables it.'
        return
    }
    if $preset not-in ['context-fast' 'resident-fast' 'persistent-fast' 'flint' 'clef-flash' 'clef' 'clef-omni'] { usage-error }
    $args = ($args | skip 1)

    # Named fast profiles retain one exact state prefix in each loaded dense
    # Clef helper. Engines without this capability ignore the setting.
    load-env {DS4_CLEF_PREFIX_CACHE: (env-or DS4_CLEF_PREFIX_CACHE '1')}

    if $preset in ['flint' 'clef-flash' 'clef' 'clef-omni'] {
        if not $server {
            print --stderr (if $preset == flint {
                'ds4-agent does not yet support Flint tool formatting. Use ds4-local --server flint --model DIR, or ds4 --model DIR for the plain CLI.'
            } else {
                'Clef profiles require --server and expose the decision APIs.'
            })
            exit 2
        }
        # These models do not use DeepSeek's cache layout or route policy.
        let incompatible = ($env | columns | where {|key| (
            ($key | str starts-with 'DS4_METAL_V41_') or
            ($key | str starts-with 'DS4_V41_') or
            ($key | str starts-with 'DS4_STATE_CACHE_') or
            ($key | str starts-with 'DS4_AGENT_CONTEXT_') or
            ($key | str starts-with 'DS4_SERVER_CONTEXT_SUFFIX_') or
            $key == 'DS4_AGENT_COMPACT_PREFIX_CACHE'
        )
        })
        hide-env --ignore-errors ...$incompatible
        if $preset != flint {
            let model = $ROOT | path join gguf $"($preset)-int4"
            exec ($bin_dir | path join 'ds4-server') --host 127.0.0.1 --model $model --ctx (if $preset == clef-omni { '64000' } else { '16384' }) ...$args
        }
        let store = env-or DS4_SERVER_RESPONSE_STORE_DIR ($ROOT | path join '.workspaces/response-store')
        mkdir ($store | path dirname)
        load-env {DS4_SERVER_RESPONSE_STORE_DIR: $store}
        exec ($bin_dir | path join 'ds4-server') --host 127.0.0.1 --batched-session 2 --ctx 262144 --prefill-chunk 4096 ...$args
    }

    mut settings = {DS4_METAL_V41_SELECTED_TILE: '64', DS4_METAL_V41_SELECTED_LIMIT: '1024'}
    if $preset in ['context-fast' 'persistent-fast'] {
        $settings = ($settings | merge {
            DS4_METAL_V41_RESIDENT_ROUTE_GAP: '0'
            DS4_METAL_V41_RESIDENT_ROUTE_NATIVE_WEIGHTS: '0'
        })
        if $server {
            $settings = ($settings | merge {
                DS4_SERVER_CONTEXT_SUFFIX_REUSE: '1'
                DS4_SERVER_CONTEXT_SUFFIX_FRESH_TAIL: (env-or DS4_SERVER_CONTEXT_SUFFIX_FRESH_TAIL '64')
                DS4_SERVER_CONTEXT_SUFFIX_CANONICAL: (env-or DS4_SERVER_CONTEXT_SUFFIX_CANONICAL '1')
                DS4_SERVER_CONTEXT_SUFFIX_PAD: (env-or DS4_SERVER_CONTEXT_SUFFIX_PAD '1')
            })
        } else {
            $settings = ($settings | merge {
                DS4_AGENT_COMPACT_PREFIX_CACHE: '1'
                DS4_AGENT_CONTEXT_FRONTIERS: '4'
                DS4_AGENT_CONTEXT_FRONTIER_MB: '512'
                DS4_AGENT_CONTEXT_SUFFIX_REUSE: '1'
                DS4_AGENT_CONTEXT_SUFFIX_PREROPE: (env-or DS4_AGENT_CONTEXT_SUFFIX_PREROPE '1')
                DS4_AGENT_CONTEXT_SUFFIX_FRESH_TAIL: '128'
            })
        }
    } else {
        $settings = ($settings | merge {DS4_AGENT_CONTEXT_SUFFIX_REUSE: '0'})
        if $server { $settings = ($settings | merge {DS4_SERVER_CONTEXT_SUFFIX_REUSE: '0'}) }
    }
    if $preset != 'context-fast' {
        $settings = ($settings | merge {
            DS4_METAL_V41_RESIDENT_ROUTE_GAP: '.90'
            DS4_METAL_V41_RESIDENT_ROUTE_MAX_MASS: '.25'
            DS4_METAL_V41_RESIDENT_ROUTE_MAX_RANK: '64'
            DS4_METAL_V41_RESIDENT_ROUTE_MAX_SUBS: '3'
            DS4_METAL_V41_RESIDENT_ROUTE_MAX_TOTAL_MASS: '.50'
            DS4_METAL_V41_RESIDENT_ROUTE_POLICY: 'replace'
            DS4_METAL_V41_RESIDENT_ROUTE_NATIVE_WEIGHTS: '1'
        })
    }
    if $preset == 'persistent-fast' {
        $settings = ($settings | merge {
            DS4_METAL_V41_RESIDENT_PREFILL_GAP: (env-or DS4_METAL_V41_RESIDENT_PREFILL_GAP '.90')
        })
        let right = if $server { 'DS4_SERVER_CONTEXT_SUFFIX_RIGHT' } else { 'DS4_AGENT_CONTEXT_SUFFIX_RIGHT' }
        $settings = ($settings | upsert $right (env-or $right '1'))
    }

    # Immutable checkpoints: bounded host RAM and restartable SSD storage.
    let cache = env-or DS4_STATE_CACHE_DIR ($ROOT | path join '.workspaces/context-cache')
    $settings = ($settings | merge {
        DS4_STATE_CACHE_DIR: $cache
        DS4_STATE_CACHE_HOT_MB: (env-or DS4_STATE_CACHE_HOT_MB (if $server { '0' } else { '512' }))
        DS4_STATE_CACHE_SSD_MB: (env-or DS4_STATE_CACHE_SSD_MB (if $server { '4096' } else { '8192' }))
    })
    mkdir ($cache | path dirname)

    $settings = ($settings | merge (shader-settings))
    mut defaults = [
        '--ssd-streaming'
        '--ssd-streaming-cache-experts'
        '64GB'
        '--ctx'
        '8192'
        '--prefill-chunk'
        '512'
    ]
    let program = if $server {
        let store = env-or DS4_SERVER_RESPONSE_STORE_DIR ($ROOT | path join '.workspaces/response-store')
        mkdir ($store | path dirname)
        $settings = ($settings | upsert DS4_SERVER_RESPONSE_STORE_DIR $store)
        $defaults = (['--host' '127.0.0.1' '--batched-session' '2'] ++ $defaults)
        'ds4-server'
    } else {
        'ds4-agent'
    }
    load-env $settings
    exec ($bin_dir | path join $program) ...$defaults ...$args
}
