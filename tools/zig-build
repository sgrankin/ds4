#!/usr/bin/env nu
# Keep build caches and useful local artifacts under the workspace.
const ROOT = path self ..

def --wrapped main [...args: string] {
    cd $ROOT
    $env.ZIG_GLOBAL_CACHE_DIR = ($ROOT | path join '.workspaces/zig-build/global-cache')
    $env.ZIG_LOCAL_CACHE_DIR = ($ROOT | path join '.workspaces/zig-build/local-cache')
    exec zig build ...$args
}
