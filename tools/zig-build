#!/bin/sh
# Keep Zig caches and outputs independent of the Make baseline.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
export ZIG_GLOBAL_CACHE_DIR="$root/.workspaces/zig-build/global-cache"
export ZIG_LOCAL_CACHE_DIR="$root/.workspaces/zig-build/local-cache"
exec zig build -j12 "$@"
